{
  "name": "smartcook",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:compat": "tsc -p tsconfig.standalone.json && cp src/styles/app.scss css/smartcook-main.css",
    "build:all": "npm run build && npm run build:compat",
    "check:compat": "tsc -p tsconfig.standalone.json --noEmit",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint src",
    "stylelint": "stylelint 'src/**/*.{vue,scss,css}'",
    "typecheck": "vue-tsc --noEmit"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^6.0.0",
    "@nextcloud/l10n": "^3.3.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.8.2",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.1.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vue-tsc": "^3.1.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
