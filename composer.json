{
  "name": "smartcook/smartcook",
  "description": "Intelligent, multilingual recipe management for Nextcloud",
  "license": "MIT",
  "type": "project",
  "autoload": {
    "psr-4": {
      "OCA\\SmartCook\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\SmartCook\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find lib tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test:unit": "phpunit -c tests/phpunit.xml",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "test:smoke": "php tests/smoke.php",
    "test": [
      "@lint",
      "@test:smoke",
      "@test:unit"
    ]
  },
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "nextcloud/ocp": "dev-stable31",
    "phpunit/phpunit": "^10.5",
    "nextcloud/coding-standard": "^1.5",
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  }
}
